# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (TEMPLATE)
# Sistema SCADA de Monitoreo de Robots Soldadores - Industria 4.0
# Copia este archivo como '.env' para configuración local o pásalas a Google Cloud Run
# ==============================================================================

# --------------------------------------------------
# 1. Configuración de Servidor Web y Contenedor
# --------------------------------------------------
PORT=8080
NODE_ENV=production
HOST=0.0.0.0

# --------------------------------------------------
# 2. Configuración de Google Cloud Platform (GCP)
# --------------------------------------------------
# ID de tu proyecto en Google Cloud Platform
GCP_PROJECT_ID=smart-factory-monitoreo-prod

# Región primaria de despliegue (Cloud Run, Pub/Sub, BigQuery)
GCP_REGION=us-central1

# Nombre del servicio en Cloud Run
CLOUD_RUN_SERVICE_NAME=scada-robots-monitor

# Repositorio de Artifact Registry para almacenar las imágenes Docker
GCP_ARTIFACT_REPOSITORY=smart-factory-docker-repo

# --------------------------------------------------
# 3. Ingesta de Datos IoT con Google Cloud Pub/Sub
# Arquitectura: Robots Soldadores (IoT Gateway) -> Pub/Sub
# --------------------------------------------------
# Tópico Pub/Sub donde los PLCs/Robots publican paquetes de telemetría MQTT/JSON
PUBSUB_TOPIC_TELEMETRIA=telemetria-robots-soldadores

# Suscripción Pub/Sub que procesa los eventos en tiempo real
PUBSUB_SUBSCRIPTION_SCADA=sub-telemetria-scada-service

# --------------------------------------------------
# 4. Almacén Analítico de Big Data con Google BigQuery
# Arquitectura: Microservicio -> BigQuery (Almacén Histórico y ML)
# --------------------------------------------------
# Dataset en BigQuery para datos industriales
BIGQUERY_DATASET=planta_soldadura_dataset

# Tabla para series temporales de corriente, temperatura y horas
BIGQUERY_TABLE_TELEMETRIA=historial_telemetria_robots

# Tabla para auditoría de alertas críticas y mantenimiento preventivo
BIGQUERY_TABLE_ALERTAS=historial_alertas_mantenimiento

# --------------------------------------------------
# 5. Reglas Operativas Industriales de Alerta
# --------------------------------------------------
ALERT_TEMP_CRITICAL=400
ALERT_CURRENT_WARNING=140
REFRESH_INTERVAL_SECONDS=5
