# Variables de entorno y secretos locales (NUNCA subir a GitHub)
.env
.env.local
.env.*.local

# Dependencias (si se instalan en el futuro)
node_modules/
package-lock.json

# Logs del sistema y servidores
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de editores y sistemas operativos
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Archivos temporales
*.tmp
*.temp
